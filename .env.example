# ==============================================================================
# MedVeda — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your system.
# Linux/macOS: cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env
# Windows CMD: copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Port Configuration
# ------------------------------------------------------------------------------
# Frontend & Reverse Proxy Server Port (Default: 3000)
PORT=3000

# Python FastAPI AI Microservice Port (Default: 8001)
PYTHON_PORT=8001

# Base URL used by the Node reverse proxy to communicate with Python AI backend
PYTHON_SERVICE_URL=http://127.0.0.1:8001

# Optional explicit path to Python binary (leave commented/blank for auto-detection)
# Windows: C:\Python312\python.exe or .venv\Scripts\python.exe
# Linux/macOS: /usr/bin/python3 or .venv/bin/python
# PYTHON_PATH=

# Node Environment (development | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Google Gemini AI & Clinical LLM Credentials
# ------------------------------------------------------------------------------
# Primary Google Gemini API Key (Required for 3-Agent Pipeline, Intake NLP & MediBot)
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier for Clinical Reasoning, Triage, and Prompt Audits
# Supported options: gemini-3.5-flash-lite (default/fast), gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. Geospatial & Catchment Settings
# ------------------------------------------------------------------------------
# Nominatim geocoding base URL (Leaflet/OSM free services - no API key required)
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Locked maximum catchment radius in kilometers (Default: 50 km)
MAX_SEARCH_RADIUS_KM=50
