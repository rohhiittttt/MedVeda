{
  "name": "@nexusmind/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types ../frontend/server.js",
    "build": "node -e \"console.log('@nexusmind/backend: use-cases ready for node --experimental-transform-types')\"",
    "start": "node --experimental-transform-types ../frontend/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/unit/*.spec.ts",
    "test:watch": "node --experimental-transform-types --watch --test tests/unit/*.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-transform-types src/infrastructure/db/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "zod": "^3.24.1",
    "ioredis": "^5.4.2",
    "@google/genai": "^0.2.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
