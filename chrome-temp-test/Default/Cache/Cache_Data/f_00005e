        )
      );
    } else {
      const url = match[0];
      elements.push(
        React.createElement('a', {
          key: `raw-link-${keyIdx++}`,
          href: url,
          target: "_blank",
          rel: "noopener noreferrer" ,
          className: "text-sky-600 hover:text-sky-800 underline font-bold inline-flex items-center gap-0.5 mx-0.5 break-all"        , __self: this, __source: {fileName: _jsxFileName, lineNumber: 9239}}

